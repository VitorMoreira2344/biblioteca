{
  "name": "biblioteca-comunitaria",
  "version": "1.0.0",
  "description": "Projeto Final DAD - Sistema de gestão de uma biblioteca comunitária (Electron + TypeScript + MySQL)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "test": "tsc -p tsconfig.testes.json && node dist/testes/tests/testes.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "mysql2": "^3.23.3",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "electron": "^45.5.0",
    "typescript": "^5.9.0"
  }
}
